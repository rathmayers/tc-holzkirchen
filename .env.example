# GitHub Personal Access Token (contents:write)
# https://github.com/settings/tokens
GITHUB_TOKEN=

# Admin-Zugangsdaten (E-Mail-Adressen der berechtigten Personen)
ADMIN_EMAIL_1=
ADMIN_EMAIL_2=

# Geheimer Schlüssel zum Signieren von Tokens – langer zufälliger String
# Generieren mit: openssl rand -hex 32
ADMIN_SECRET=

# Resend API Key für E-Mail-Versand
# https://resend.com/api-keys
RESEND_API_KEY=
